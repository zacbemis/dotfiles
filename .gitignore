# Runtime-generated color files (created by pywal / matugen)
.config/*/colors/
# Neovim's colors/ contains source themes; generated palettes live in lua/colors/.
!.config/nvim/colors/
.config/quickshell/colors.css
.config/kitty/colors.conf
.config/nvim/lua/colors/
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css

# Dynamic wallpaper symlink
.config/hypr/current_wallpaper

# GTK theme symlinks managed by nwg-look
.config/gtk-4.0/gtk.css
.config/gtk-4.0/gtk-dark.css
.config/gtk-4.0/assets

# Tool directories are deny-by-default: only reviewed settings/source are tracked.
# Never import an entire live tool directory with --adopt or git add -f.
.ssh/
.gnupg/
.netrc
.npmrc
.bash_history
.zsh_history
.claude.json
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/herdr-agent-state.sh

.codex/*
!.codex/hooks.json
!.codex/herdr-agent-state.sh
.cursor/*
!.cursor/hooks.json
!.cursor/herdr-agent-state.sh
.copilot/*
!.copilot/settings.json
!.copilot/hooks/
.copilot/hooks/*
!.copilot/hooks/herdr-agent-state.sh
.gemini/
.vscode/
.config/cursor/
.config/pi/
.config/nvm/
.config/github-copilot/

.pi/*
!.pi/agent/
!.pi/web-search.json
.pi/agent/*
!.pi/agent/settings.json
!.pi/agent/multi-pass.json
!.pi/agent/extensions/
.pi/agent/extensions/*
!.pi/agent/extensions/herdr-agent-state.ts

.config/herdr/*
!.config/herdr/config.toml
!.config/herdr/reload-colors.sh
!.config/herdr/sync-colors.py
.config/gh/*
!.config/gh/config.yml
.config/htop/*
!.config/htop/htoprc

.config/opencode/*
!.config/opencode/opencode.jsonc
!.config/opencode/tui.jsonc
!.config/opencode/package.json
!.config/opencode/herdr-tui-session.js
!.config/opencode/plugins/
.config/opencode/plugins/*
!.config/opencode/plugins/herdr-agent-state.js

.config/Code/*
!.config/Code/User/
.config/Code/User/*
!.config/Code/User/settings.json
!.config/Code/User/keybindings.json
!.config/Code/User/snippets/
.config/Cursor/*
!.config/Cursor/User/
.config/Cursor/User/*
!.config/Cursor/User/settings.json
!.config/Cursor/User/keybindings.json
!.config/Cursor/User/snippets/

# Python runtime/test bytecode
__pycache__/
*.py[cod]

